{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "day17-api",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "compatibility_date": "2026-11-04",
  "main": "src/index.ts",
  "routes": [
    { "pattern": "build40for40.com/lantern/api", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/lantern/api/*", "zone_name": "build40for40.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "day17", "database_id": "efc1fd96-d5d1-43cb-af68-beed69ab97c1", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "SMS_PROVIDER": "textbelt",
    "SIGNAL_NUMBER": ""
  },
  "secrets": { "required": ["SESSION_SECRET"] }
}
