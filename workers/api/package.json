{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "The day17 api Worker.",
  "type": "module",
  "scripts": {
    "dev": "pnpm wrangler dev --port 8787",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-interface Env",
    "deploy": "pnpm wrangler deploy",
    "wrangler": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL wrangler --profile 40for40"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
