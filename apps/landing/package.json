{
  "name": "landing",
  "version": "0.0.0",
  "private": true,
  "description": "The Day 17 landing page.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && vite build",
    "preview": "pnpm build && pnpm wrangler dev",
    "test": "vitest run",
    "typecheck": "vue-tsc --build",
    "deploy": "pnpm build && pnpm wrangler deploy",
    "wrangler": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL wrangler --profile 40for40"
  },
  "dependencies": {
    "contract": "workspace:*",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.158.0"
  }
}
